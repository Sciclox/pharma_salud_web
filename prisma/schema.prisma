generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sucursal {
  id                Int                  @id @default(autoincrement())
  nombre            String               @unique
  direccion         String?
  estado            String               @default("activo")
  fechaCreacion     DateTime             @default(now()) @map("fecha_creacion")
  carritoItems      CarritoVentas[]
  fechasVencimiento ExpiracionLote[]
  inventarios       InventarioSucursal[]
  kardex            Kardex[]
  ventas            RegistroVentas[]
  sobrantesCaja     SobranteCaja[]
  usuarios          Usuario[]

  @@map("sucursal")
}

model Usuario {
  id             Int              @id @default(autoincrement()) @map("id_usuario")
  nombreUsuario  String           @unique @map("nombre_usuario")
  nombreVendedor String           @map("nombre_vendedor")
  clave          String
  rol            String           @default("Vendedor")
  sucursalId     Int?             @map("sucursal_id")
  genero         String?
  estado         String           @default("activo")
  carritoItems   CarritoVentas[]
  detallesVenta  DetalleVenta[]
  ventas         RegistroVentas[]
  sobrantesCaja  SobranteCaja[]
  sucursal       Sucursal?        @relation(fields: [sucursalId], references: [id])

  @@map("usuario")
}

model Producto {
  id                          Int                  @id @default(autoincrement())
  nombreProducto              String               @map("nombre_producto")
  cantidadPresentacion        Int?                 @map("cantidad_presentacion")
  cantidadPresentacionBlister Int?                 @map("cantidad_presentacion_blister")
  fechaCreacion               DateTime             @default(now()) @map("fecha_creacion")
  laboratorioId               Int?                 @map("laboratorio_id")
  categoriaId                 Int?                 @map("categoria_id")
  carritoItems                CarritoVentas[]
  detallesVenta               DetalleVenta[]
  fechasVencimiento           ExpiracionLote[]
  inventarios                 InventarioSucursal[]
  kardex                      Kardex[]
  categoria                   Categoria?           @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  laboratorio                 Laboratorio?         @relation(fields: [laboratorioId], references: [id])

  @@map("producto")
}

model InventarioSucursal {
  id            Int      @id @default(autoincrement())
  productoId    Int      @map("producto_id")
  sucursalId    Int      @map("sucursal_id")
  cantidadTotal Int      @default(0) @map("cantidad_total")
  precioCaja    Float    @default(0) @map("precio_caja")
  precioUnidad  Float    @default(0) @map("precio_unidad")
  costoCaja     Float    @default(0) @map("costo_caja")
  costoUnidad   Float    @default(0) @map("costo_unidad")
  stockMinimo   Int      @default(0) @map("stock_minimo")
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([productoId, sucursalId])
  @@map("inventario_sucursal")
}

model RegistroVentas {
  id         Int            @id @default(autoincrement())
  sucursalId Int            @map("sucursal_id")
  usuarioId  Int            @map("usuario_id")
  fecha      DateTime       @default(now())
  total      Float          @default(0)
  pagoCon    Float          @default(0) @map("pago_con")
  vuelto     Float          @default(0)
  detalles   DetalleVenta[]
  sucursal   Sucursal       @relation(fields: [sucursalId], references: [id])
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])

  @@map("registro_de_ventas")
}

model DetalleVenta {
  id              Int            @id @default(autoincrement())
  registroVentaId Int            @map("registro_venta_id")
  productoId      Int            @map("producto_id")
  nombreProducto  String         @map("nombre_producto")
  usuarioId       Int            @map("usuario_id")
  fecha           DateTime       @default(now())
  tipoVenta       String         @map("tipo_venta")
  cantidad        Int
  precioVenta     Float          @map("precio_venta")
  devolucion      String         @default("No")
  producto        Producto       @relation(fields: [productoId], references: [id])
  registroVenta   RegistroVentas @relation(fields: [registroVentaId], references: [id], onDelete: Cascade)
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])

  @@map("detalles_venta")
}

model CarritoVentas {
  id          Int      @id @default(autoincrement())
  productoId  Int      @map("producto_id")
  sucursalId  Int      @map("sucursal_id")
  idUsuario   Int      @map("id_usuario")
  cantidad    Int
  precioVenta Float    @map("precio_venta")
  tipoVenta   String   @map("tipo_venta")
  fecha       DateTime @default(now())
  usuario     Usuario  @relation(fields: [idUsuario], references: [id])
  producto    Producto @relation(fields: [productoId], references: [id])
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id])

  @@map("carrito_de_ventas")
}

model Kardex {
  id              Int      @id @default(autoincrement())
  sucursalId      Int      @map("sucursal_id")
  productoId      Int      @map("producto_id")
  nombreProducto  String   @map("nombre_producto")
  fechaMovimiento DateTime @default(now()) @map("fecha_movimiento")
  tipoMovimiento  String   @map("tipo_movimiento")
  cantidad        Int
  idDetalleVenta  Int?     @map("id_detalle_venta")
  producto        Producto @relation(fields: [productoId], references: [id])
  sucursal        Sucursal @relation(fields: [sucursalId], references: [id])

  @@map("kardex")
}

model ExpiracionLote {
  id               Int      @id @default(autoincrement())
  sucursalId       Int      @map("sucursal_id")
  productoId       Int      @map("producto_id")
  fechaVencimiento DateTime @map("fecha_vencimiento")
  cantidad         Int      @default(0)
  producto         Producto @relation(fields: [productoId], references: [id])
  sucursal         Sucursal @relation(fields: [sucursalId], references: [id])

  @@map("fecha_vencimiento")
}

model SobranteCaja {
  id         Int      @id @default(autoincrement())
  sucursalId Int      @map("sucursal_id")
  usuarioId  Int      @map("usuario_id")
  fecha      DateTime @default(now())
  monto      Float
  nota       String?
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("sobrante_caja")
}

model Categoria {
  id            Int        @id @default(autoincrement())
  nombre        String     @unique
  descripcion   String?
  estado        String     @default("activo")
  fechaCreacion DateTime   @default(now()) @map("fecha_creacion")
  productos     Producto[]

  @@map("categoria")
}

model Laboratorio {
  id            Int        @id @default(autoincrement())
  nombre        String     @unique
  descripcion   String?
  estado        String     @default("activo")
  fechaCreacion DateTime   @default(now()) @map("fecha_creacion")
  productos     Producto[]

  @@map("laboratorio")
}
